+}
+
+/* ── small multiples ───────────────────────────────────────────── */
+const TRACKS = [["Cin", "drug inside", "#a78bfa"], ["D", "DNA damage", "#e0a640"],
+                ["p53", "p53", "#e0a640"], ["C3", "caspase-3", "#e0675a"]];
