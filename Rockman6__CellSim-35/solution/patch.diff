+  $("explain").append(msg);
+  if (warn) {
+    const w = document.createElement("div");
+    w.className = "known";
+    w.innerHTML = `<b>Known limitation.</b> ${warn}`;
+    $("explain").append(w);
+  }
+}
+
+function drawLog(t) {
+  const evs = S.trace.cells[S.cell].events;
