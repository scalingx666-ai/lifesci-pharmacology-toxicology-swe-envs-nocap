+
+/* ── the cell itself ───────────────────────────────────────────── */
+const PHASE = { G1: ["#4ea8de", "G1 — growing, getting ready"],
+                S:  ["#35b3a2", "S — copying its DNA"],
+                G2: ["#7c9cf0", "G2 — checking the copy"],
+                M:  ["#f0c050", "M — dividing"],
+                dead: ["#596572", "dead"] };
+function drawCell(f) {
+  const cell = S.trace.cells[S.cell], ph = cell.phase[f], svg = $("cellview");
