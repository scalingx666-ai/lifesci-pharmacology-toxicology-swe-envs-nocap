+  const cell = S.trace.cells[S.cell], n = S.trace.t_h.length;
+  $("tracks").innerHTML = TRACKS.map(([k, lab]) =>
+    `<div class="track"><div class="tl">${lab}</div><svg viewBox="0 0 100 34" preserveAspectRatio="none" data-k="${k}"></svg></div>`).join("");
