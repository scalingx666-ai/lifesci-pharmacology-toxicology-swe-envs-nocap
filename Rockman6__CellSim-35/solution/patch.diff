+function drawPicker() {
+  $("cellpick").innerHTML = S.trace.cells.map((c, i) =>
+    `<button data-i="${i}" class="${i === S.cell ? "on" : ""}">Cell ${i + 1}<span class="fate">${fateOf(c)}</span></button>`).join("");
