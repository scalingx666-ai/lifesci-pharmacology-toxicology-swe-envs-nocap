+    const gap = justDivided ? 34 : arrested ? 10 : 18;
+    for (const dx of [-gap, gap])
+      el("circle", { cx: 110 + dx, cy: 110, r: 50, fill: col, opacity: 0.22,
+                     stroke: col, "stroke-width": 2 }, svg);
