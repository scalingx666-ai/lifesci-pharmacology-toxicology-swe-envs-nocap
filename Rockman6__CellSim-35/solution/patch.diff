+    const dmg = level("D", f);
+    for (let i = 0; i < Math.round(dmg * 9); i++) {
+      const a = i * 2.4, rr = nr * 0.6;
+      el("circle", { cx: 110 + Math.cos(a) * rr * (0.4 + (i % 3) * 0.25),
+                     cy: 110 + Math.sin(a) * rr * (0.4 + (i % 3) * 0.25),
+                     r: 2.6, fill: "#e0a640" }, svg);
