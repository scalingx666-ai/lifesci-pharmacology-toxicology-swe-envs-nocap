+    omega = NULL,
+    covariates = covariates,
+    output_include = incl,
+    t_obs = t_obs_sim,
+    only_obs = TRUE,
+    ...
+  )
+  if(!is.null(t_obs)) {
+    res <- res[res$t %in% t_obs_sim, ]
+  } else {
+    res <- res[nrow(res),]
+  }
+  return(as.list(res[, -c(1:4)]))
 }
