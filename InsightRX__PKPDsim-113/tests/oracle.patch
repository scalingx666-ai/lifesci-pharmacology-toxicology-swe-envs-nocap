+int first_dose_index(std::vector<double> time, std::vector<int> evid) {
+  // find row index for first dose (evid=1, doesn't have to be first event row)
+  // returns 0 if no dose given at all
+  int index = 0;
+  for(int i = 0; i < time.size(); i++) {
+    if(evid[i] == 1) {
+      index = i;
+      break;
+    }
+  }
+  return(index);
+}
