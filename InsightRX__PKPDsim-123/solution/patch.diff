+test_that("covariates are shifted correctly when t_ss != 0", {
+  covs <- list(
+    SCR = new_covariate(
+      value = c(0.5, 0.9),
+      times = c(3, 30),
+      implementation = "interpolate"
+    ),
+    CRRT = new_covariate(
