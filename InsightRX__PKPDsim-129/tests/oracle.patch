+{
+  "id": "pk_vanco_adane",
+  "ode_code": "\
+    dAdt[0] = -(CLi/Vi)*A[0] \
+    dAdt[1] = A[0]/Vi ",
+  "pk_code": "\
+    BSA = pow(WT,0.425) * pow(HT,0.725) * 0.007184 \
