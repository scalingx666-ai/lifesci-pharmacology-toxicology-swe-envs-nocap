+test_that("simulatenous doses in different cmts do not remove infusion stops", {
+  reg <- new_regimen(
+    amt = c(100, 10, 100, 10, 100, 10),
+    times = c(0, 0, 12, 12, 24, 24),
+    t_inf = 0.5,
+    type = rep(c("drug_1", "drug_2"), 3)
